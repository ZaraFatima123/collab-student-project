{
  "name": "group9-project-management",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "docs:export": "tsx scripts/export-openapi.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:embedded": "node scripts/embedded-tests.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "embedded-postgres": "17.6.0-beta.15",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
